# Application
APP_ENV=local
DEMO_ACCESS_MODE=anonymous

# Document intake limits
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=20
MAX_IMAGE_PIXELS=25000000
PROCESSING_TIMEOUT_SECONDS=60

# Retention
DOCUMENT_RETENTION_HOURS=24

# Anonymous live-processing limits
PROCESSING_RATE_LIMIT_PER_SESSION_PER_HOUR=3
PROCESSING_RATE_LIMIT_PER_IP_PER_HOUR=20
PROCESSING_MAX_CONCURRENCY=2

# Cost controls
DAILY_PROCESSING_BUDGET_KRW=5000
DAILY_BUDGET_WARNING_PERCENT=70
DAILY_BUDGET_STOP_PERCENT=100
LIVE_PROCESSING_KILL_SWITCH=false

# Local MinIO development adapter
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=money-lens-local
MINIO_ACCESS_KEY=set-in-local-env
MINIO_SECRET_KEY=set-in-local-env

# Local PostgreSQL (collection store)
POSTGRES_USER=money_lens
POSTGRES_PASSWORD=money-lens-local
POSTGRES_DB=money_lens
DATABASE_URL=postgresql://money_lens:money-lens-local@localhost:5432/money_lens
